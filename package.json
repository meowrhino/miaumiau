{
  "name": "miaumiau",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create miaumiau-db",
    "db:migrate": "wrangler d1 execute miaumiau-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute miaumiau-db --file=schema.sql --local"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.69.0"
  }
}
